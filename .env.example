# ReelSnap - Environment Configuration Example

# Server Port (Default: 3000)
PORT=3000

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Allowed CORS origins (comma-separated or '*' for all)
CORS_ORIGIN=*

# Rate Limiting configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
DOWNLOAD_RATE_LIMIT_MAX=20

# (Optional) Instagram Session Cookie for higher rate limits or regional bypass
# Example: sessionid=...; csrftoken=...; ds_user_id=...
INSTAGRAM_COOKIE=

# (Optional) RapidAPI Fallback Provider Key (if you want external failover)
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-downloader-download-instagram-videos-stories1.p.rapidapi.com
